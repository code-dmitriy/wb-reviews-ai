# Скопируйте этот файл в .env и заполните. Файл .env никуда не отправляется.

# Токен бота от @BotFather
TG_BOT_TOKEN=
# Ваш числовой chat id (узнать: написать боту @userinfobot)
TG_CHAT_ID=
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# demo — демо-отзывы из файла; wb — официальный API продавца
MODE=demo
# Нужен только для MODE=wb: токен WB с доступом «Вопросы и отзывы»
WB_API_TOKEN=

# Модель можно поменять без правки воркфлоу
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Сколько отзывов брать за один запуск (экономит лимит бесплатных моделей)
REVIEWS_LIMIT=6
